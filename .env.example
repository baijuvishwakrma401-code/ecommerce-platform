# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local example:   postgresql://postgres:postgres@localhost:5432/ecommerce
# Supabase example: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce"

# NextAuth
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Cloud/object storage (wired up in the image-upload phase)
# e.g. an S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, etc.)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_URL=""
