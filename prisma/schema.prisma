// ---------------------------------------------------------------------------
// PHASE 1 SCHEMA
// Covers: authentication, customers, admin users, roles & permissions.
// Product/order/inventory/settings models are added in later phases
// (see README.md "Roadmap") so each phase can be migrated and tested
// independently, per the project's phased build plan.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// CUSTOMER-FACING AUTH
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String?
  emailVerified DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  @@map("users")
  @@index([email])
}

// ---------------------------------------------------------------------------
// ADMIN-SIDE AUTH + RBAC
// A separate table from `users` intentionally: admin credentials must never
// share a table (or a login endpoint) with customer credentials.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. SUPER_ADMIN, ADMIN, MANAGER
  description String?
  createdAt   DateTime @default(now())

  admins      AdminUser[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "products.manage", "orders.manage"
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminUser {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?

  @@map("admin_users")
  @@index([email])
}

// ---------------------------------------------------------------------------
// AUDIT LOG (thin, expands in later phases)
// Tracks sensitive admin actions e.g. logins, role changes.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorType  String // "ADMIN" | "CUSTOMER"
  action     String // e.g. "ADMIN_LOGIN", "ADMIN_LOGIN_FAILED"
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
  @@index([actorId])
}
